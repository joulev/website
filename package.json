    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.31",
    "autoprefixer": "10.5.4",
    "concurrently": "10.0.3",
    "cva": "1.0.0-beta.8",
    "discord-api-types": "0.38.50",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "github-slugger": "2.0.0",
    "graphql": "16.14.2",
    "graphql-request": "7.4.0",
